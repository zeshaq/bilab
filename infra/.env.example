# Copy to .env and fill in real values. Never commit .env (gitignored).

# Warehouse (Trino/Iceberg in the lab)
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=trino
TRINO_CATALOG=iceberg

# Cube
CUBE_DB_TYPE=trino
CUBE_DB_URL=
